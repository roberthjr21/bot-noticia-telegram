# 1. Crea el bot desde Telegram hablando con @BotFather y usando /newbot.
# 2. Copia este archivo como .env (sin .example) y pega el token privado.
TELEGRAM_BOT_TOKEN=PON_AQUI_TU_TOKEN

# Zona horaria y hora predeterminada (formato 24 horas)
BOT_TZ=America/Bogota
BOT_DAILY_TIME=08:00

# Opcional: restringe el bot a tus IDs numéricos (Telegram: /miid).
# Dejar vacío permite cualquier usuario en chat PRIVADO.
ALLOWED_USER_IDS=

# Carpeta local de datos (excluida del repositorio)
DATA_DIR=data

# Voz española de Colombia; puedes usar es-CO-GonzaloNeural.
TTS_VOICE=es-CO-SalomeNeural
